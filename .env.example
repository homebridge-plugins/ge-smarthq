# GE SmartHQ OAuth2 Credentials
# Get these from the GE SmartHQ Mobile App or developer console
# Default values are provided for public API credentials, but you can override them here
SMARTHQ_OAUTH2_CLIENT_ID=your_client_id_here
SMARTHQ_OAUTH2_CLIENT_SECRET=your_client_secret_here

# Optional: Override the default API endpoints
# SMARTHQ_API_BASE_URL=https://client.mysmarthq.com
# SMARTHQ_LOGIN_URL=https://accounts.brillion.geappliances.com
