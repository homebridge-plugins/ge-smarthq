{
  "name": "ge-smarthq",
  "version": "1.1.0",
  "type": "module",
  "description": "GE SmartHQ appliances module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "npm install && npm outdated",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "build": "npm run clean && tsc && tsc-alias",
    "watch": "tsc -w",
    "prepublishOnly": "npm run lint && npm run build && npm run docs && npm run docs:lint",
    "postpublish": "npm run clean",
    "clean": "rm -rf ./dist",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test-coverage": "npm run test -- --coverage",
    "docs": "typedoc",
    "docs:lint": "typedoc --emit none --treatWarningsAsErrors"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homebridge-plugins/ge-smarthq.git"
  },
  "keywords": [
    "ge",
    "smarthq",
    "appliances"
  ],
  "author": "Homebridge Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/homebridge-plugins/ge-smarthq/issues"
  },
  "homepage": "https://github.com/homebridge-plugins/ge-smarthq#readme",
  "engines": {
    "node": "^20 || ^22 || ^24"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "chalk": "^6.0.0",
    "express": "^5.2.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint-plugin-format": "^2.0.1",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "tsc-alias": "^1.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
