{
  "name": "ge-smarthq",
  "version": "1.0.0",
  "description": "GE SmartHQ appliances module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "npm install && npm outdated",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "build": "npm run clean && tsc && tsc-alias",
    "watch": "tsc -w",
    "prepublishOnly": "npm run lint && npm run build && npm run docs && npm run docs:lint",
    "postpublish": "npm run clean",
    "clean": "shx rm -rf ./dist",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test-coverage": "npm run test -- --coverage",
    "docs": "typedoc",
    "docs:lint": "typedoc --emit none --treatWarningsAsErrors"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homebridge-plugins/ge-smarthq.git"
  },
  "keywords": [
    "ge",
    "smarthq",
    "appliances"
  ],
  "author": "Homebridge Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/homebridge-plugins/ge-smarthq/issues"
  },
  "homepage": "https://github.com/homebridge-plugins/ge-smarthq#readme",
  "engines": {
    "node": "^20 || ^22 || ^24"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "axios-cookiejar-support": "^6.0.4",
    "cheerio": "^1.1.2",
    "lodash": "^4.17.21",
    "openid-client": "^5.7.0",
    "rxjs": "^7.8.2",
    "tough-cookie": "^6.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.0.1",
    "@types/lodash": "^4.17.23",
    "@types/node": "^25.0.9",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.34.0",
    "eslint-plugin-format": "^1.3.1",
    "eslint-plugin-import": "^2.32.0",
    "homebridge": "^1.11.1",
    "nodemon": "^3.1.10",
    "shx": "^0.4.0",
    "tsc-alias": "^1.8.16",
    "typedoc": "^0.28.16",
    "typescript": "^5.9.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "vitest": "^4.0.18"
  }
}
