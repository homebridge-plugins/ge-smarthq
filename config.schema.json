{
  "pluginAlias": "GESmartHQ",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "This plugin integrates GE SmartHQ appliances with HomeKit",
  "footerDisplay": "For more information see the [README](https://github.com/homebridge-plugins/ge-smarthq#readme).",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "GE SmartHQ",
        "description": "The name of the platform"
      },
      "username": {
        "title": "SmartHQ Username",
        "type": "string",
        "required": true,
        "description": "Your GE SmartHQ account username/email"
      },
      "password": {
        "title": "SmartHQ Password",
        "type": "string",
        "required": true,
        "description": "Your GE SmartHQ account password"
      },
      "region": {
        "title": "Region",
        "type": "string",
        "default": "US",
        "enum": ["US", "EU"],
        "description": "Your SmartHQ region"
      },
      "refreshInterval": {
        "title": "Refresh Interval (minutes)",
        "type": "integer",
        "default": 5,
        "minimum": 1,
        "maximum": 60,
        "description": "How often to refresh appliance data (in minutes)"
      },
      "debug": {
        "title": "Enable Debug Logging",
        "type": "boolean",
        "default": false,
        "description": "Enable debug logging for troubleshooting"
      }
    },
    "required": ["username", "password"]
  }
}